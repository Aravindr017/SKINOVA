# ==========================================
# SKINOVA .gitignore
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# --- User Uploads & Runtime Artifacts ---
backend/uploads/*
!backend/uploads/.gitkeep
*.log
*.tmp
*.temp

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# AI Agents & IDE Cache
.gemini/
.agents/
.cache/
hf_cache/
