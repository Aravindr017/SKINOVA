# ========================================================
# SKINOVA — Master Environment Configuration Template
# ========================================================
# For local development:
# 1. Copy backend/.env.example to backend/.env and fill in your keys
# 2. Copy frontend/.env.example to frontend/.env and fill in your keys
# (Alternatively, you can place this file as .env in the project root)
#
# IMPORTANT: Never commit files named .env to Git! They contain private secrets.
# ========================================================

# --------------------------------------------------------
# 1. BACKEND CONFIGURATION (FastAPI Server)
# --------------------------------------------------------

# Google Gemini API Key (Powers the AI Clinical Consultant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (Enables Google Sign-In & token verification)
# Create in Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# (Optional) OpenAI API Key for GPT-4o fallback
OPENAI_API_KEY=

# (Optional) Local Ollama Server for offline local LLMs
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:0.5b

# --------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vite React App)
# --------------------------------------------------------

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# Google Sign-In OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
